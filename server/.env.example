# Copy only to C:/PlannerServer/config/server.env. Initialize with scripts/Initialize-Server.ps1.
PUBLIC_BASE_URL=https://replace-before-publication.invalid
PLANNER_API_PORT=3030
POSTGRES_PASSWORD=
AUTH_SECRET=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ALLOWED_REGISTRATION_EMAILS=
ALLOW_PUBLIC_REGISTRATION=false
ACCOUNT_QUOTA_BYTES=1073741824
MAX_FILE_BYTES=104857600
# Use a separate drive/computer. Forward slashes in Windows paths.
BACKUP_REPOSITORY_PATH=E:/PlannerBackups
RESTIC_PASSWORD=

# Explicit proxy IPs/CIDRs only, determined using Test-Proxy.ps1 on Windows. Empty means no trust.
TRUSTED_PROXY_CIDRS=
USER_REQUESTS_PER_MINUTE=300
PUBLIC_REQUESTS_PER_MINUTE=300
# Image version is normally selected by the supplied Compose file.
# PLANNER_SERVER_VERSION=0.1.1

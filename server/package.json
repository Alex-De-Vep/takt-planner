{
  "name": "planner-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/main.js worker",
    "migrate": "node dist/main.js migrate",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "nodemailer": "10.3.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}

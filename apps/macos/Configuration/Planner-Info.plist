<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
        <!-- Для этих доменов проверяем цепочку HTTPS с корнем GigaChat внутри приложения. -->
        <key>NSExceptionDomains</key>
        <dict>
            <key>ngw.devices.sberbank.ru</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
            </dict>
            <key>api.giga.chat</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
            </dict>
        </dict>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleURLName</key><string>$(PLANNER_APP_BUNDLE_IDENTIFIER).widget</string>
            <key>CFBundleURLSchemes</key><array><string>$(PLANNER_APP_BUNDLE_IDENTIFIER).widget</string></array>
        </dict>
    </array>
    <key>TaktWidgetURLScheme</key>
    <string>$(PLANNER_APP_BUNDLE_IDENTIFIER).widget</string>
    <key>TaktWidgetAppGroup</key>
    <string>$(PLANNER_WIDGET_APP_GROUP)</string>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>local.planner.task</string>
            <key>UTTypeDescription</key><string>Takt task reference</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string></array>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>local.planner.note</string>
            <key>UTTypeDescription</key><string>Takt note reference</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string></array>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>local.planner.calendar-event</string>
            <key>UTTypeDescription</key><string>Takt calendar event</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string></array>
        </dict>
    </array>
</dict>
</plist>

<Window x:Class="Takt.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Takt.Windows.ViewModels" xmlns:notes="using:Takt.Windows.Controls" Title="Takt">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="Root" RowSpacing="0" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Padding="0,0,140,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="TitleDragRegion" Padding="16,0" Background="Transparent"><TextBlock Text="Takt" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/></Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button ToolTipService.ToolTip="Help" AutomationProperties.Name="Help">
     <Button.Content><SymbolIcon Symbol="Help"/></Button.Content>
     <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Guide" Click="Guide_Click"/><MenuFlyoutItem Text="Welcome" Click="Welcome_Click"/><MenuFlyoutItem Text="Contact support…" Click="Support_Click"/></MenuFlyout></Button.Flyout>
    </Button>
    <ToggleButton x:Name="ChatToggle" Click="ChatToggle_Click" ToolTipService.ToolTip="AI chat" AutomationProperties.Name="AI chat"><FontIcon Glyph="&#xE8BD;"/></ToggleButton>
    <ToggleButton x:Name="CalendarToggle" Click="CalendarToggle_Click" ToolTipService.ToolTip="Calendar" AutomationProperties.Name="Calendar"><SymbolIcon Symbol="Calendar"/></ToggleButton>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="232"
     IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
   <NavigationView.PaneHeader><StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8">
    <Button Click="NewFolder_Click" ToolTipService.ToolTip="New folder" AutomationProperties.Name="New folder"><FontIcon Glyph="&#xE8F4;"/></Button>
    <Button Click="Settings_Click" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><SymbolIcon Symbol="Setting"/></Button>
   </StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Inbox" Tag="inbox" Icon="Mail" AllowDrop="True" DragOver="Folder_DragOver" Drop="Folder_Drop"/>
    <NavigationViewItem Content="Today" Tag="today" Icon="Favorite" AllowDrop="True" DragOver="Folder_DragOver" Drop="Folder_Drop"/>
    <NavigationViewItem Content="This Week" Tag="week" Icon="Calendar" AllowDrop="True" DragOver="Folder_DragOver" Drop="Folder_Drop"/>
    <NavigationViewItem Content="Month" Tag="month" Icon="Calendar" AllowDrop="True" DragOver="Folder_DragOver" Drop="Folder_Drop"/>
    <NavigationViewItem Content="All Tasks" Tag="all" Icon="AllApps"/>
    <NavigationViewItem Content="All Notes" Tag="notes:all" Icon="Document"/>
    <NavigationViewItem Content="Unfiled Notes" Tag="notes:unfiled" Icon="Page"/>
    <NavigationViewItem Content="Recently Deleted" Tag="notes:trash" Icon="Delete"/>
    <NavigationViewItemHeader Content="My folders"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems><NavigationViewItem x:Name="AccountItem" Content="Local library" Tag="account" Icon="Contact" SelectsOnInvoked="False" Tapped="Account_Tapped"/></NavigationView.FooterMenuItems>
   <Grid x:Name="DocumentsAndPanel">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="DocumentsColumn" Width="*"/><ColumnDefinition x:Name="PanelSplitterColumn" Width="0"/><ColumnDefinition x:Name="RightPanelColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="DocumentViews">
   <Grid x:Name="WorkspaceGrid" SizeChanged="Root_SizeChanged" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="0,0,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="350" MinWidth="260"/><ColumnDefinition x:Name="SplitterColumn" Width="16"/><ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
    <Grid x:Name="ListPane" RowSpacing="12" Padding="16,16,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="SectionTitle" Text="Inbox" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="TaskCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ToggleSwitch x:Name="FolderNotesSwitch" Header="Show notes in this folder" Visibility="Collapsed" Toggled="FolderNotes_Toggled"/></StackPanel>
     <AutoSuggestBox x:Name="Search" Grid.Row="1" PlaceholderText="Search tasks" QueryIcon="Find" TextChanged="Search_TextChanged" AutomationProperties.Name="Search tasks"/>
     <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
       <TextBlock x:Name="EmptyList" Text="No tasks here yet" Margin="8,24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <ListView x:Name="TasksList" ItemsSource="{x:Bind ActiveTasks}" SelectionMode="Single" SelectionChanged="Task_SelectionChanged"
          CanDragItems="True" DragItemsStarting="Tasks_DragItemsStarting" KeyDown="TaskList_KeyDown">
        <ListView.ItemTemplate><DataTemplate x:DataType="vm:TaskRow">
         <Grid Padding="4,10" ColumnSpacing="6" MinHeight="64" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="4"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Visibility="{x:Bind DeadlineVisibility}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" HorizontalAlignment="Left" Padding="6,2"><TextBlock Text="{x:Bind DeadlineLabel}" Style="{StaticResource CaptionTextBlockStyle}"/></Border></StackPanel>
          <ToggleButton Grid.Column="1" Tag="{x:Bind Id}" IsChecked="{x:Bind Completed}" Click="Complete_Click" AutomationProperties.Name="Complete task" ToolTipService.ToolTip="Complete task"><FontIcon Glyph="&#xE73E;"/></ToggleButton>
          <ToggleButton Grid.Column="2" Tag="{x:Bind Id}" IsChecked="{x:Bind Focused}" Click="Focus_Click" AutomationProperties.Name="Add to Today" ToolTipService.ToolTip="Add to Today"><SymbolIcon Symbol="Favorite"/></ToggleButton>
         </Grid>
        </DataTemplate></ListView.ItemTemplate>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
       </ListView>
       <Expander x:Name="CompletedExpander" Header="Completed" HorizontalAlignment="Stretch">
        <ListView x:Name="CompletedList" ItemsSource="{x:Bind CompletedTasks}" SelectionMode="Single" SelectionChanged="Task_SelectionChanged" KeyDown="TaskList_KeyDown">
         <ListView.ItemTemplate><DataTemplate x:DataType="vm:TaskRow"><Grid ColumnSpacing="12" Padding="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ToggleButton Tag="{x:Bind Id}" IsChecked="{x:Bind Completed}" Click="Complete_Click" AutomationProperties.Name="Reopen task"><FontIcon Glyph="&#xE73E;"/></ToggleButton><TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
       </Expander>
      </StackPanel>
     </ScrollViewer>
     <Button Grid.Row="3" Click="NewTask_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock Text="Add a task"/></StackPanel></Button>
    </Grid>
    <!-- The invisible resize target is 16 DIP; it adds no hover decoration. -->
    <Thumb x:Name="ResizeHandle" Grid.Column="1" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True"
       AutomationProperties.Name="Resize task list" DragStarted="Resize_DragStarted" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" KeyDown="Resize_KeyDown">
     <Thumb.Template><ControlTemplate TargetType="Thumb"><notes:ResizeCursorGrid Background="Transparent"/></ControlTemplate></Thumb.Template>
    </Thumb>
    <Grid x:Name="DetailPane" Grid.Column="2" RowSpacing="12" Padding="8,8,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <CommandBar DefaultLabelPosition="Collapsed" Background="Transparent" HorizontalContentAlignment="Left">
      <AppBarButton x:Name="BackButton" Icon="Back" Label="Back" Click="Back_Click" Visibility="Collapsed"/>
      <AppBarButton Icon="Edit" Label="New task" Click="NewTask_Click"/>
      <AppBarButton x:Name="AddItemButton" Icon="Bullets" Label="Add subtask" Click="AddItem_Click" IsEnabled="False"/>
      <AppBarButton x:Name="DeadlineButton" Icon="Clock" Label="Task deadline" IsEnabled="False" Click="Deadline_Click">
       <AppBarButton.Flyout><Flyout Placement="Bottom"><StackPanel Spacing="12" Width="300">
        <TextBlock Text="Task deadline" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <CalendarDatePicker x:Name="DeadlineDate" Header="Date" PlaceholderText="Choose a date"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Today" Click="DeadlineToday_Click"/><Button Content="Tomorrow" Click="DeadlineTomorrow_Click"/></StackPanel>
        <ToggleSwitch x:Name="IncludeTime" Header="Include time" Toggled="IncludeTime_Toggled"/>
        <TimePicker x:Name="DeadlineTime" Header="Time" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Clear" Click="ClearDeadline_Click"/><Button Content="Apply" Style="{StaticResource AccentButtonStyle}" Click="ApplyDeadline_Click"/></StackPanel>
       </StackPanel></Flyout></AppBarButton.Flyout>
      </AppBarButton>
      <AppBarButton x:Name="PlanTimeButton" Icon="Calendar" Label="Plan time for task" Click="PlanTime_Click" IsEnabled="False"/>
      <AppBarButton x:Name="CopyTaskButton" Icon="Copy" Label="Copy whole task" Click="CopyTask_Click" IsEnabled="False"/>
      <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Delete task" Click="DeleteTask_Click" IsEnabled="False"/>
     </CommandBar>
     <TextBlock x:Name="EmptyEditor" Grid.Row="1" Text="Select a task to see its details" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <ScrollViewer Grid.Row="1" x:Name="EditorScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" Padding="8,8,16,16">
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="Location" Header="Folder" DisplayMemberPath="Name" SelectedValuePath="Key" HorizontalAlignment="Stretch"/>
        <ToggleButton x:Name="EditorFocus" Grid.Column="1" VerticalAlignment="Bottom" Click="EditorFocus_Click" AutomationProperties.Name="Add to Today" ToolTipService.ToolTip="Add to Today"><SymbolIcon Symbol="Favorite"/></ToggleButton>
       </Grid>
       <TextBlock x:Name="CreatedAt" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBox x:Name="TaskTitle" Header="Task" PlaceholderText="Task title" TextWrapping="Wrap" AcceptsReturn="True" FontSize="24" KeyDown="Title_KeyDown"/>
       <TextBox x:Name="Description" Header="Description" PlaceholderText="Add a description" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" KeyDown="Description_KeyDown"/>
       <TextBlock x:Name="DeadlineSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       <StackPanel x:Name="ScheduledBlocks" Spacing="6" Visibility="Collapsed"/>
       <TextBlock x:Name="ChecklistHeading" Text="Subtasks" Style="{StaticResource BodyStrongTextBlockStyle}"/>
       <ListView x:Name="Checklist" ItemsSource="{x:Bind ChecklistItems}" SelectionMode="None" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="Checklist_DragItemsCompleted">
        <ListView.ItemTemplate><DataTemplate x:DataType="vm:ChecklistRow"><Grid Padding="0,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox Tag="{x:Bind Id}" IsChecked="{x:Bind Completed}" Click="ItemComplete_Click" AutomationProperties.Name="Complete subtask"/><Button Grid.Column="1" Tag="{x:Bind Id}" Click="RenameItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/></Button><Button Grid.Column="2" Tag="{x:Bind Id}" Click="DeleteItem_Click" AutomationProperties.Name="Delete subtask" ToolTipService.ToolTip="Delete subtask"><SymbolIcon Symbol="Delete"/></Button></Grid></DataTemplate></ListView.ItemTemplate>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
       </ListView>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NewItemTitle" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Add a subtask" KeyDown="NewItem_KeyDown" AutomationProperties.Name="New subtask"/><Button x:Name="CreateSubtaskButton" Grid.Column="1" Click="CreateItem_Click" AutomationProperties.Name="Add subtask"><SymbolIcon Symbol="Add"/></Button></Grid>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save changes" Click="SaveTask_Click" Style="{StaticResource AccentButtonStyle}"/><ToggleButton x:Name="EditorComplete" Content="Completed" Click="EditorComplete_Click"/></StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
   <notes:NotesWorkspace x:Name="NotesView" Visibility="Collapsed"/>
   </Grid>
   <Thumb x:Name="PanelResize" Grid.Column="1" Visibility="Collapsed" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True" AutomationProperties.Name="Resize right panel" DragStarted="PanelResize_Started" DragDelta="PanelResize_Delta" KeyDown="PanelResize_KeyDown">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><notes:ResizeCursorGrid Background="Transparent"/></ControlTemplate></Thumb.Template>
   </Thumb>
   <notes:CalendarWorkspace x:Name="CalendarView" Grid.Column="2" Visibility="Collapsed"/>
   <notes:ChatWorkspace x:Name="ChatView" Grid.Column="2" Visibility="Collapsed"/>
   </Grid>
  </NavigationView>
  <StackPanel Grid.Row="2" Spacing="4" Padding="12,4">
   <Grid x:Name="GlobalRecording" Visibility="Collapsed" ColumnSpacing="8" Padding="0,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="GlobalRecordingStatus" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
    <Button x:Name="GlobalRecordingPause" Grid.Column="1" Content="Pause" Click="GlobalRecordingPause_Click"/>
    <Button Grid.Column="2" Content="Stop recording" Click="GlobalRecordingStop_Click"/>
   </Grid>
   <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error"/>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SyncStatus" Text="Opening library…" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
    <Button x:Name="QueueButton" Grid.Column="1" Content="Review failed changes" Visibility="Collapsed" Click="Queue_Click"/>
    <Button x:Name="SyncButton" Grid.Column="2" Content="Sync" Click="Sync_Click" IsEnabled="False"/>
   </Grid>
  </StackPanel>
 </Grid>
</Window>

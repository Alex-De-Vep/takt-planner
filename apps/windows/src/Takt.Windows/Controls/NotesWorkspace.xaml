<UserControl x:Class="Takt.Windows.Controls.NotesWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Takt.Windows.Controls" xmlns:vm="using:Takt.Windows.ViewModels"
 SizeChanged="Workspace_SizeChanged">
 <Grid x:Name="NoteRoot" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="0,0,12,0">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Columns" SizeChanged="Workspace_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="NoteListColumn" Width="350" MinWidth="260"/><ColumnDefinition x:Name="NoteSplitterColumn" Width="16"/><ColumnDefinition x:Name="NoteEditorColumn" Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid x:Name="NoteListPane" Padding="16,16,0,12" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="NotesHeading" Text="All Notes" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="NotesCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <Button Grid.Row="1" x:Name="FolderTasksButton" Content="Tasks in this folder" Click="FolderTasks_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
    <AutoSuggestBox Grid.Row="2" x:Name="NotesSearch" PlaceholderText="Search notes" QueryIcon="Find" TextChanged="Search_TextChanged" AutomationProperties.Name="Search notes"/>
    <Grid Grid.Row="3">
     <TextBlock x:Name="EmptyNotes" Text="No notes here yet" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <ListView x:Name="NotesList" ItemsSource="{x:Bind Rows}" SelectionChanged="Notes_SelectionChanged" CanDragItems="True" DragItemsStarting="Notes_DragItemsStarting" KeyDown="Notes_KeyDown">
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:NoteRow"><StackPanel Padding="8,10" Spacing="5">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE718;" FontSize="12" Visibility="{x:Bind PinVisibility}"/><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/></StackPanel>
       <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock Text="{x:Bind Updated}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel></DataTemplate></ListView.ItemTemplate>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     </ListView>
    </Grid>
    <StackPanel Grid.Row="4" Spacing="8"><TextBlock x:Name="TrashHint" Text="Notes are permanently removed after 30 days." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"/>
     <Button x:Name="CreateNoteButton" Click="NewNote_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock Text="New note"/></StackPanel></Button>
    </StackPanel>
   </Grid>
   <Thumb x:Name="NoteResize" Grid.Column="1" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True" AutomationProperties.Name="Resize notes list" DragStarted="Resize_Started" DragDelta="Resize_Delta" KeyDown="Resize_KeyDown">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><controls:ResizeCursorGrid Background="Transparent"/></ControlTemplate></Thumb.Template>
   </Thumb>
   <Grid x:Name="NoteDetailPane" Grid.Column="2" Padding="8,8,0,12" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <CommandBar DefaultLabelPosition="Collapsed" Background="Transparent" HorizontalContentAlignment="Left">
     <AppBarButton x:Name="NotesBack" Icon="Back" Label="Back" Click="Back_Click" Visibility="Collapsed"/>
     <AppBarButton x:Name="NewNoteToolbar" Icon="Edit" Label="New note" Click="NewNote_Click"/>
     <AppBarButton x:Name="RecordNoteButton" Icon="Microphone" Label="Record voice note" Click="RecordVoice_Click"/>
     <AppBarButton x:Name="RecordCallButton" Icon="Phone" Label="Record system audio and microphone" Click="RecordCall_Click"/>
     <AppBarToggleButton x:Name="PinNoteButton" Icon="Pin" Label="Pin note" Click="PinNote_Click" IsEnabled="False"/>
     <AppBarButton x:Name="TrashNoteButton" Icon="Delete" Label="Move to Recently Deleted" Click="TrashNote_Click" IsEnabled="False"/>
     <AppBarButton x:Name="RestoreNoteButton" Icon="Undo" Label="Restore note" Click="RestoreNote_Click" Visibility="Collapsed"/>
     <CommandBar.SecondaryCommands>
      <AppBarButton Label="Export notes backup" Click="ExportNotes_Click"/>
      <AppBarButton Label="Import notes backup" Click="ImportNotes_Click"/>
      <AppBarButton Label="Import local notes into this account" Click="UploadLocalNotes_Click"/>
      <AppBarButton Label="Transcription settings" Click="TranscriptionSettings_Click"/>
     </CommandBar.SecondaryCommands>
    </CommandBar>
    <TextBlock x:Name="NoNoteSelected" Grid.Row="1" Text="Select a note to see its contents" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ScrollViewer Grid.Row="1" x:Name="NoteEditorScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="14" Padding="8,8,16,16">
      <ComboBox x:Name="NoteFolder" Header="Folder" DisplayMemberPath="Name" SelectedValuePath="Key" HorizontalAlignment="Stretch" SelectionChanged="Folder_SelectionChanged"/>
      <TextBlock x:Name="NoteUpdated" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBox x:Name="NoteTitle" Header="Title" PlaceholderText="New note" TextWrapping="Wrap" AcceptsReturn="True" FontSize="28" FontWeight="SemiBold" TextChanged="Title_TextChanged" KeyDown="Title_KeyDown"/>
      <ListView x:Name="AudioClips" SelectionMode="None" ItemClick="Audio_ItemClick" IsItemClickEnabled="True"/>
      <CommandBar x:Name="FormatBar" DefaultLabelPosition="Collapsed" Background="Transparent" HorizontalContentAlignment="Left">
       <AppBarButton Icon="Bold" Label="Bold" Tag="bold" Click="Format_Click"/>
       <AppBarButton Icon="Italic" Label="Italic" Tag="italic" Click="Format_Click"/>
       <AppBarButton Icon="Underline" Label="Underline" Tag="underline" Click="Format_Click"/>
       <AppBarButton Label="Heading" Tag="heading" Click="Format_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8D2;"/></AppBarButton.Icon></AppBarButton>
       <AppBarButton Label="Body" Tag="body" Click="Format_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8D2;"/></AppBarButton.Icon></AppBarButton>
       <AppBarButton Icon="Bullets" Label="Bulleted list" Tag="bullet" Click="Format_Click"/>
       <AppBarButton Icon="List" Label="Numbered list" Tag="number" Click="Format_Click"/>
       <AppBarButton Icon="Accept" Label="Checklist" Tag="check" Click="Format_Click"/>
       <AppBarButton Icon="Link" Label="Insert link" Click="InsertLink_Click"/>
       <AppBarButton Icon="Pictures" Label="Insert image" Click="InsertImage_Click"/>
      </CommandBar>
      <RichEditBox x:Name="NoteBody" MinHeight="340" Header="Note" PlaceholderText="Start writing…" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16" TextChanged="Body_TextChanged" Paste="Body_Paste" KeyDown="Body_KeyDown" PointerPressed="Body_PointerPressed" IsSpellCheckEnabled="True"/>
      <Button Content="Save changes" Click="SaveNote_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
      <StackPanel x:Name="RecordingCard" Grid.Row="1" Margin="16,0,16,8" Spacing="8" Visibility="Collapsed" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
       <TextBlock x:Name="RecordingLabel" Text="Voice recording" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PauseRecording" Content="Pause" Click="PauseRecording_Click"/><Button x:Name="StopRecording" Content="Stop" Click="StopRecording_Click"/></StackPanel>
      </StackPanel>
  <InfoBar x:Name="NotesProblem" Grid.Row="2" IsOpen="False" Severity="Warning" IsClosable="True"/>
 </Grid>
</UserControl>
